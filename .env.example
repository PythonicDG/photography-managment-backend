EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=your-address@gmail.com
FRONTEND_URL=http://localhost:8080

# WhatsApp Business Cloud API (Meta) - see ../WHATSAPP_SETUP.md
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_QUOTE_TEMPLATE=quotation_document
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Subscriptions & billing - plans/prices are managed in Django admin (Billing > Plans)
BILLING_TRIAL_DAYS=15
BILLING_GRACE_DAYS=3
BILLING_GST_PERCENT=18
BILLING_BRAND_NAME=FrameFlow

# Razorpay - see ../RAZORPAY_SETUP.md
# Test keys start with rzp_test_, live keys with rzp_live_. Never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
